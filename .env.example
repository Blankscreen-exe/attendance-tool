# Copy to .env and adjust. Lines starting with # are ignored.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# true only on your own machine; it shows error details to anyone.
DEBUG=false

# Hostnames the app is reached at, comma separated.
ALLOWED_HOSTS=attendance.example.com
# Needed when served over HTTPS behind a proxy, comma separated, with scheme.
CSRF_TRUSTED_ORIGINS=https://attendance.example.com
# true when users reach the app over HTTPS (marks cookies as secure).
HTTPS=false

# Company timezone. Times are stored in UTC and shown in this zone.
TIME_ZONE=Asia/Karachi
# Hour (0-23) at which the attendance day rolls over. 0 = midnight.
DAY_ROLLOVER_HOUR=0

# Leave empty to use SQLite (stored in ./data, or the attendance_data volume in Docker).
# For Postgres: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Email notices (optional). Leave EMAIL_HOST empty to send nothing.
# Use the SMTP details from your mail provider. Where the provider gives an
# API key for SMTP, it goes in EMAIL_HOST_PASSWORD, and EMAIL_HOST_USER is
# whatever fixed username the provider documents (for example "apikey").
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587 uses STARTTLS (the default). For port 465 set EMAIL_USE_SSL=true instead.
EMAIL_USE_SSL=false
# The address notices are sent from. It must be one your provider lets you send as.
EMAIL_FROM=

# Only for docker-compose.postgres.yml, which runs its own Postgres container.
POSTGRES_PASSWORD=

# Docker only: creates the first admin account on startup if none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
